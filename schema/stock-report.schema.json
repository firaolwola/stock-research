{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-research.local/schema/stock-report/4.0.0",
  "title": "Stock Research Report",
  "description": "Version 4.0.0 contract for fast and deep stock-research reports. Scores use deterministic methodology and are not investment advice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "metadata", "security", "issuer", "sections", "financial_assessment", "catalyst_assessment", "scores", "claims", "sources"],
  "properties": {
    "schema_version": { "const": "4.0.0" },
    "report_id": { "$ref": "#/$defs/nonEmptyString" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "security": { "$ref": "#/$defs/security" },
    "issuer": { "$ref": "#/$defs/issuer" },
    "financial_assessment": { "$ref": "#/$defs/financialAssessment" },
    "catalyst_assessment": { "$ref": "#/$defs/catalystAssessment" },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reverse_splits", "dilution", "dividends", "compliance_and_warnings", "financial_context", "catalysts_and_news"],
      "properties": {
        "reverse_splits": { "$ref": "#/$defs/reportSection" },
        "dilution": { "$ref": "#/$defs/reportSection" },
        "dividends": { "$ref": "#/$defs/reportSection" },
        "compliance_and_warnings": { "$ref": "#/$defs/reportSection" },
        "financial_context": { "$ref": "#/$defs/reportSection" },
        "catalysts_and_news": { "$ref": "#/$defs/reportSection" }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dilution_historical_severity", "dilution_future_likelihood", "dilution_potential_impact", "reverse_split_risk", "financial_health", "long_term_company_quality", "catalyst_strength", "near_term_setup_quality"],
      "properties": {
        "dilution_historical_severity": { "$ref": "#/$defs/score" },
        "dilution_future_likelihood": { "$ref": "#/$defs/score" },
        "dilution_potential_impact": { "$ref": "#/$defs/score" },
        "reverse_split_risk": { "$ref": "#/$defs/score" },
        "financial_health": { "$ref": "#/$defs/score" },
        "financial_revenue_trend": { "$ref": "#/$defs/score" },
        "financial_net_income_trend": { "$ref": "#/$defs/score" },
        "financial_debt_trend": { "$ref": "#/$defs/score" },
        "financial_free_cash_flow_trend": { "$ref": "#/$defs/score" },
        "financial_cash_trend": { "$ref": "#/$defs/score" },
        "financial_operating_cash_flow_trend": { "$ref": "#/$defs/score" },
        "long_term_company_quality": { "$ref": "#/$defs/score" },
        "catalyst_strength": { "$ref": "#/$defs/score" },
        "near_term_setup_quality": { "$ref": "#/$defs/score" }
      }
    },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "uniqueItems": true },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" }, "uniqueItems": true }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "dateTime": { "type": "string", "format": "date-time" },
    "evidenceState": { "enum": ["confirmed", "not_found", "unknown", "not_applicable", "limited_coverage"] },
    "confidence": { "enum": ["high", "medium", "low", "unknown"] },
    "claimId": { "type": "string", "pattern": "^claim-[A-Za-z0-9._-]+$" },
    "sourceId": { "type": "string", "pattern": "^source-[A-Za-z0-9._-]+$" },
    "researchWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["topic", "start", "end"],
      "properties": { "topic": { "$ref": "#/$defs/nonEmptyString" }, "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" } }
    },
    "limitation": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "explanation", "affected_sections"],
      "properties": { "code": { "$ref": "#/$defs/nonEmptyString" }, "explanation": { "$ref": "#/$defs/nonEmptyString" }, "affected_sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true } }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["as_of", "generated_at", "stage", "completion_status", "research_windows", "coverage_limitations"],
      "properties": {
        "as_of": { "$ref": "#/$defs/dateTime" }, "generated_at": { "$ref": "#/$defs/dateTime" },
        "stage": { "enum": ["fast", "deep"] }, "completion_status": { "enum": ["complete", "partial", "pending"] },
        "research_windows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/researchWindow" } },
        "coverage_limitations": { "type": "array", "items": { "$ref": "#/$defs/limitation" } }
      }
    },
    "security": {
      "type": "object", "additionalProperties": false,
      "required": ["ticker", "name", "security_type", "listing_venue", "listing_status", "evidence_state", "claim_ids"],
      "properties": {
        "ticker": { "type": "string", "pattern": "^[A-Z0-9.-]{1,15}$" }, "name": { "$ref": "#/$defs/nonEmptyString" },
        "security_type": { "enum": ["common_stock", "adr", "etf", "warrant", "preferred_stock", "foreign_ordinary_share", "other", "unknown"] },
        "listing_venue": { "$ref": "#/$defs/nonEmptyString" }, "listing_status": { "enum": ["active", "halted", "suspended", "delisted", "unknown"] },
        "evidence_state": { "$ref": "#/$defs/evidenceState" }, "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "priorIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "ticker", "effective_from", "effective_to", "linkage_state", "linkage_confidence", "claim_ids"],
      "properties": {
        "name": { "type": ["string", "null"], "minLength": 1 }, "ticker": { "type": ["string", "null"], "pattern": "^[A-Z0-9.-]{1,15}$" },
        "effective_from": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }, "effective_to": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "linkage_state": { "$ref": "#/$defs/evidenceState" }, "linkage_confidence": { "$ref": "#/$defs/confidence" }, "claim_ids": { "$ref": "#/$defs/claimIds" }
      },
      "anyOf": [{ "required": ["name"], "properties": { "name": { "type": "string" } } }, { "required": ["ticker"], "properties": { "ticker": { "type": "string" } } }]
    },
    "issuer": {
      "type": "object", "additionalProperties": false,
      "required": ["legal_name", "cik", "identity_state", "identity_confidence", "prior_identities", "claim_ids"],
      "properties": {
        "legal_name": { "$ref": "#/$defs/nonEmptyString" }, "cik": { "type": ["string", "null"], "pattern": "^[0-9]{10}$" },
        "identity_state": { "$ref": "#/$defs/evidenceState" }, "identity_confidence": { "$ref": "#/$defs/confidence" },
        "prior_identities": { "type": "array", "items": { "$ref": "#/$defs/priorIdentity" } }, "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "claimIds": { "type": "array", "items": { "$ref": "#/$defs/claimId" }, "uniqueItems": true },
    "sectionItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "title", "state", "summary", "event_date", "claim_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["reverse_split", "offering", "warrant", "convertible", "other_dilution", "dividend", "exchange_compliance", "going_concern", "sec_warning", "accounting_warning", "cash", "cash_burn", "revenue", "profitability", "free_cash_flow", "debt", "catalyst", "news", "other"] },
        "title": { "$ref": "#/$defs/nonEmptyString" }, "state": { "$ref": "#/$defs/evidenceState" }, "summary": { "$ref": "#/$defs/nonEmptyString" },
        "event_date": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
          "period_start": { "$ref": "#/$defs/date" }, "period_end": { "$ref": "#/$defs/date" },
          "evidence_role": { "enum": ["actual_issuance", "registration_capacity", "potential_issuance", "instrument_overhang", "context"] },
          "corporate_action_state": { "enum": ["completed", "authorized", "proposed", "unknown"] },
          "value": { "type": "number" }, "unit": { "$ref": "#/$defs/nonEmptyString" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      },
      "dependentRequired": { "value": ["unit"], "unit": ["value"] }
    },
    "reportSection": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "summary", "coverage_notes", "items", "claim_ids"],
      "properties": { "state": { "$ref": "#/$defs/evidenceState" }, "summary": { "$ref": "#/$defs/nonEmptyString" }, "coverage_notes": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }, "items": { "type": "array", "items": { "$ref": "#/$defs/sectionItem" } }, "claim_ids": { "$ref": "#/$defs/claimIds" } }
    },
    "financialMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "label", "value", "unit", "period_start", "period_end", "trend", "comparison_period_start", "comparison_period_end", "summary", "claim_ids"],
      "properties": {
        "state": { "$ref": "#/$defs/evidenceState" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"], "minLength": 1 },
        "period_start": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "period_end": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "trend": { "enum": ["improving", "stable", "deteriorating", "mixed", "unknown", "not_applicable"] },
        "comparison_period_start": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "comparison_period_end": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "observations": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/financialObservation" } },
        "annual_observations": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/financialObservation" } },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "financialObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "period_start", "period_end", "claim_ids"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "period_start": { "$ref": "#/$defs/date" },
        "period_end": { "$ref": "#/$defs/date" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "financialWarning": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "state", "severity", "title", "as_of", "summary", "claim_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["liquidity", "cash_burn", "debt", "going_concern", "profitability", "accounting", "other"] },
        "state": { "$ref": "#/$defs/evidenceState" },
        "severity": { "enum": ["critical", "high", "medium", "low", "unknown"] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "as_of": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "goingConcernAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "as_of", "summary", "claim_ids"],
      "properties": {
        "state": { "$ref": "#/$defs/evidenceState" },
        "as_of": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "financialAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "as_of", "reporting_currency", "summary", "coverage_notes", "metrics", "going_concern", "material_warnings"],
      "properties": {
        "state": { "$ref": "#/$defs/evidenceState" },
        "as_of": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "reporting_currency": { "type": ["string", "null"], "minLength": 3 },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "coverage_notes": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["cash", "cash_burn", "revenue", "profitability", "free_cash_flow", "debt"],
          "properties": {
            "cash": { "$ref": "#/$defs/financialMetric" },
            "cash_burn": { "$ref": "#/$defs/financialMetric" },
            "revenue": { "$ref": "#/$defs/financialMetric" },
            "profitability": { "$ref": "#/$defs/financialMetric" },
            "operating_cash_flow": { "$ref": "#/$defs/financialMetric" },
            "free_cash_flow": { "$ref": "#/$defs/financialMetric" },
            "debt": { "$ref": "#/$defs/financialMetric" }
          }
        },
        "shares_outstanding": { "$ref": "#/$defs/shareSeries" },
        "going_concern": { "$ref": "#/$defs/goingConcernAssessment" },
        "material_warnings": { "type": "array", "items": { "$ref": "#/$defs/financialWarning" } }
      }
    },
    "shareSeries": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "summary", "observations", "claim_ids"],
      "properties": {
        "state": { "$ref": "#/$defs/evidenceState" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "observations": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/financialObservation" } },
        "annual_observations": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/financialObservation" } },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "assessmentFactor": {
      "type": "object", "additionalProperties": false,
      "required": ["rating", "explanation", "claim_ids"],
      "properties": {
        "rating": { "enum": ["high", "medium", "low", "unknown", "not_applicable"] },
        "explanation": { "$ref": "#/$defs/nonEmptyString" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "currentCatalyst": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "classification", "title", "event_date", "summary", "confidence", "claim_ids", "factors"],
      "properties": {
        "state": { "$ref": "#/$defs/evidenceState" },
        "classification": { "enum": ["earnings", "product", "regulatory", "financing", "contract", "corporate_action", "legal", "management", "macro_industry", "other", "unknown", "not_applicable"] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "event_date": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "claim_ids": { "$ref": "#/$defs/claimIds" },
        "factors": {
          "type": "object", "additionalProperties": false,
          "required": ["recency", "specificity", "credibility", "novelty", "potential_significance"],
          "properties": {
            "recency": { "$ref": "#/$defs/assessmentFactor" },
            "specificity": { "$ref": "#/$defs/assessmentFactor" },
            "credibility": { "$ref": "#/$defs/assessmentFactor" },
            "novelty": { "$ref": "#/$defs/assessmentFactor" },
            "potential_significance": { "$ref": "#/$defs/assessmentFactor" }
          }
        }
      }
    },
    "reactionWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "start", "end", "price_change_percent", "state", "summary", "claim_ids"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "start": { "$ref": "#/$defs/date" },
        "end": { "$ref": "#/$defs/date" },
        "price_change_percent": { "type": ["number", "null"] },
        "state": { "$ref": "#/$defs/evidenceState" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "historicalAnalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "state", "event_date", "comparison_basis", "comparison_limitations", "reaction_windows", "claim_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "state": { "$ref": "#/$defs/evidenceState" },
        "event_date": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "comparison_basis": { "$ref": "#/$defs/nonEmptyString" },
        "comparison_limitations": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "reaction_windows": { "type": "array", "items": { "$ref": "#/$defs/reactionWindow" } },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "historicalAnalogueAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "summary", "coverage_notes", "items", "claim_ids"],
      "properties": {
        "state": { "$ref": "#/$defs/evidenceState" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "coverage_notes": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/historicalAnalogue" } },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "nearTermImplication": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "direction", "summary", "confidence", "claim_ids"],
      "properties": {
        "state": { "$ref": "#/$defs/evidenceState" },
        "direction": { "enum": ["strengthens", "mixed", "weakens", "neutral", "unknown", "not_applicable"] },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "catalystAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["current", "historical_analogues", "favorable_evidence_claim_ids", "unfavorable_evidence_claim_ids", "uncertainty", "near_term_implication"],
      "properties": {
        "current": { "$ref": "#/$defs/currentCatalyst" },
        "historical_analogues": { "$ref": "#/$defs/historicalAnalogueAssessment" },
        "favorable_evidence_claim_ids": { "$ref": "#/$defs/claimIds" },
        "unfavorable_evidence_claim_ids": { "$ref": "#/$defs/claimIds" },
        "uncertainty": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "near_term_implication": { "$ref": "#/$defs/nearTermImplication" }
      }
    },
    "scoreComponent": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "state", "value", "weight", "explanation", "claim_ids"],
      "properties": {
        "key": { "$ref": "#/$defs/nonEmptyString" },
        "state": { "$ref": "#/$defs/evidenceState" },
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "explanation": { "$ref": "#/$defs/nonEmptyString" },
        "claim_ids": { "$ref": "#/$defs/claimIds" }
      }
    },
    "score": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "value", "scale_min", "scale_max", "direction", "time_horizon", "explanation", "claim_ids", "confidence", "methodology_version", "components"],
      "properties": {
        "state": { "$ref": "#/$defs/evidenceState" }, "value": { "type": ["number", "null"], "minimum": 0, "maximum": 10 }, "scale_min": { "const": 0 }, "scale_max": { "const": 10 },
        "direction": { "enum": ["higher_is_more_risk", "higher_is_better"] }, "time_horizon": { "$ref": "#/$defs/nonEmptyString" }, "explanation": { "$ref": "#/$defs/nonEmptyString" }, "claim_ids": { "$ref": "#/$defs/claimIds" },
        "confidence": { "$ref": "#/$defs/confidence" }, "methodology_version": { "enum": ["2.0.0", "2.1.0"] }, "components": { "type": "array", "items": { "$ref": "#/$defs/scoreComponent" } }
      },
      "allOf": [
        { "if": { "properties": { "state": { "enum": ["unknown", "not_applicable", "limited_coverage", "not_found"] } }, "required": ["state"] }, "then": { "properties": { "value": { "type": "null" } } } },
        { "if": { "properties": { "state": { "const": "confirmed" } }, "required": ["state"] }, "then": { "properties": { "value": { "type": "number" } } } }
      ]
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "materiality", "state", "as_of", "source_ids"],
      "properties": { "id": { "$ref": "#/$defs/claimId" }, "text": { "$ref": "#/$defs/nonEmptyString" }, "materiality": { "enum": ["high", "medium", "low"] }, "state": { "$ref": "#/$defs/evidenceState" }, "as_of": { "$ref": "#/$defs/dateTime" }, "source_ids": { "type": "array", "items": { "$ref": "#/$defs/sourceId" }, "uniqueItems": true } }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "url", "published_date", "source_type", "confidence", "retrieved_at", "supported_claim_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" }, "title": { "$ref": "#/$defs/nonEmptyString" }, "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "published_date": { "$ref": "#/$defs/date" }, "source_type": { "enum": ["sec_filing", "exchange_notice", "company_release", "company_filing", "original_news", "secondary_aggregator", "other_primary", "other_secondary"] },
        "confidence": { "$ref": "#/$defs/confidence" }, "retrieved_at": { "$ref": "#/$defs/dateTime" }, "supported_claim_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claimId" }, "uniqueItems": true }
      }
    }
  }
}
