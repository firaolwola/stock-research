  "rubric": {
    "material_risk_recall": { "target": 0.95, "report_by_category": true, "unit": "known high- or medium-materiality facts" },
    "completeness": { "measure": "expected evidence categories explicitly addressed" },
    "source_quality": { "measure": "primary-source share and source metadata quality" },
    "factual_support": { "measure": "detected claims supported by cited evidence" },
    "lineage": { "measure": "confirmed predecessor facts carried only through supported identity links" },
    "uncertainty": { "measure": "expected unknown, limited-coverage, or not-applicable states preserved without favorable inference" },
    "latency": { "measure": "per-case milliseconds; report distribution only for approved live samples" },
    "cost": { "measure": "per-case estimated USD from recorded usage and web searches" },
    "clarity": { "measure": "manual 1–5 rating for concise, non-advisory, decision-focused wording" },
    "failure_partition": { "measure": "application/transport failures reported separately from research misses" }
  },
